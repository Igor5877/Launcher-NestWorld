<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="layout" prefHeight="560.0" prefWidth="930.0" styleClass="background" stylesheets="@update.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Навбар -->
    <AnchorPane id="header" prefHeight="48.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="0.0">
            <children>
                <StackPane id="headerLogoBadge" alignment="CENTER" maxHeight="26.0" maxWidth="26.0" minHeight="26.0" minWidth="26.0" prefHeight="26.0" prefWidth="26.0">
                    <children>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/logo.png" />
                            </image>
                        </ImageView>
                    </children>
                </StackPane>
                <Label styleClass="scene-header" text="%runtime.scenes.update.headingDialog" />
            </children>
        </HBox>
        <HBox id="controls" alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="0.0">
            <children>
                <fx:include source="../../components/buttons/cancel.fxml" />
                <fx:include source="../../components/buttons/minimize.fxml" />
                <fx:include source="../../components/buttons/maximize.fxml" />
                <fx:include source="../../components/buttons/exit.fxml" />
            </children>
        </HBox>
    </AnchorPane>

    <!-- Основний вміст -->
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="48.0">
        <padding>
            <Insets bottom="24.0" left="51.0" right="51.0" top="20.0" />
        </padding>
        <children>

            <!-- Рядок профілю клієнта -->
            <HBox id="profileRow" alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <StackPane id="profileIconBadge" alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0">
                        <children>
                            <Label id="profileIcon" text="📦" />
                        </children>
                    </StackPane>
                    <VBox>
                        <children>
                            <Label id="profileName" text="?" />
                            <Label id="profileVersion" text="?" />
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox id="phaseBadge" alignment="CENTER" spacing="9.0">
                        <children>
                            <Label id="phaseBadgeIcon" styleClass="phase-badge-icon" text="⬇" />
                            <Label id="phaseBadgeText" styleClass="phase-badge-text" text="%runtime.scenes.update.status.downloading" />
                            <Label id="phaseBadgeCount" styleClass="phase-badge-count" text="1/4" />
                        </children>
                    </HBox>
                </children>
                <VBox.margin>
                    <Insets bottom="16.0" />
                </VBox.margin>
            </HBox>

            <!-- Основна область: чек-лист фаз + картка статусу + лог -->
            <HBox id="bodyRow" spacing="16.0" VBox.vgrow="ALWAYS">
                <children>

                    <!-- Ліва колонка: фази + картка статусу -->
                    <VBox maxWidth="170.0" minWidth="170.0" prefWidth="170.0" spacing="10.0">
                        <children>
                            <VBox id="phaseCard" alignment="CENTER_LEFT" spacing="12.0" styleClass="phase-card" VBox.vgrow="ALWAYS">
                                <children>
                                    <HBox id="phaseRowJava" alignment="CENTER_LEFT" spacing="8.0" styleClass="phase-row">
                                        <children>
                                            <Label id="phaseIconJava" styleClass="phase-icon" text="○" />
                                            <Label id="phaseTextJava" styleClass="phase-text" text="%runtime.scenes.update.phase.java" />
                                        </children>
                                    </HBox>
                                    <HBox id="phaseRowAssets" alignment="CENTER_LEFT" spacing="8.0" styleClass="phase-row">
                                        <children>
                                            <Label id="phaseIconAssets" styleClass="phase-icon" text="○" />
                                            <Label id="phaseTextAssets" styleClass="phase-text" text="%runtime.scenes.update.phase.assets" />
                                        </children>
                                    </HBox>
                                    <HBox id="phaseRowClient" alignment="CENTER_LEFT" spacing="8.0" styleClass="phase-row">
                                        <children>
                                            <Label id="phaseIconClient" styleClass="phase-icon" text="○" />
                                            <Label id="phaseTextClient" styleClass="phase-text" text="%runtime.scenes.update.phase.client" />
                                        </children>
                                    </HBox>
                                    <HBox id="phaseRowLaunch" alignment="CENTER_LEFT" spacing="8.0" styleClass="phase-row">
                                        <children>
                                            <Label id="phaseIconLaunch" styleClass="phase-icon" text="○" />
                                            <Label id="phaseTextLaunch" styleClass="phase-text" text="%runtime.scenes.update.phase.launch" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <StackPane id="statusCard" maxHeight="170.0" minHeight="170.0" prefHeight="170.0">
                                <children>
                                    <Region id="statusAccent" StackPane.alignment="TOP_CENTER" />
                                    <VBox id="speedOn" alignment="CENTER" spacing="3.0">
                                        <children>
                                            <Label id="statusValue" alignment="CENTER" maxWidth="1.7976931348623157E308" text="0" textAlignment="CENTER" />
                                            <Label id="statusSubtext" alignment="CENTER" maxWidth="1.7976931348623157E308" text="MB/S" textAlignment="CENTER" />
                                        </children>
                                    </VBox>
                                    <HBox id="statusCardFooter" alignment="CENTER" spacing="4.0" StackPane.alignment="BOTTOM_CENTER">
                                        <children>
                                            <Label id="statusPhaseLabel" text="1/4" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label id="statusPercentLabel" text="0%" />
                                        </children>
                                    </HBox>
                                </children>
                            </StackPane>
                        </children>
                    </VBox>

                    <!-- Права колонка: лог процесу -->
                    <VBox id="logColumn" HBox.hgrow="ALWAYS">
                        <children>
                            <HBox id="logHeader" alignment="CENTER_LEFT" spacing="8.0">
                                <children>
                                    <Label styleClass="log-icon" text="›_" />
                                    <Label styleClass="log-title" text="%runtime.scenes.update.logHeader" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label id="logLineCount" styleClass="log-count" text="0" />
                                </children>
                            </HBox>
                            <ScrollPane id="logScroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox id="outputUpdate" />
                                </content>
                            </ScrollPane>
                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- Нижня панель: стан, прогрес, дії -->
            <VBox id="bottomSection" spacing="7.0">
                <VBox.margin>
                    <Insets top="16.0" />
                </VBox.margin>
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label id="stateLabel" styleClass="state-label" text="%runtime.scenes.update.status.downloading" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label id="percentLabel" styleClass="percent-label" text="0%" />
                            <Label styleClass="percent-sep" text=" · " />
                            <Label id="volume" styleClass="volume-label" text="" />
                        </children>
                    </HBox>
                    <ProgressBar id="progress" maxWidth="1.7976931348623157E308" prefHeight="14.0" progress="0.0" />
                    <HBox id="actionButtons" alignment="CENTER_RIGHT" minHeight="28.0" spacing="10.0">
                        <children>
                            <Button fx:id="retryButton" managed="false" styleClass="action-button-primary" text="%runtime.scenes.update.retryButtonText" visible="false" />
                            <Button fx:id="exitButton" managed="false" styleClass="action-button-secondary" text="%runtime.scenes.update.exitButtonText" visible="false" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</AnchorPane>
