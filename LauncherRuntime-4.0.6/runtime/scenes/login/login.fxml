          <VBox alignment="CENTER" fillWidth="false" pickOnBounds="false" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
              <children>
                  <StackPane id="content" />
               <Text id="forgotPass" strokeWidth="0.0" text="%runtime.scenes.login.forgotPass" textAlignment="RIGHT">
