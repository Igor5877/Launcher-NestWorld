<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="layout" prefHeight="560.0" prefWidth="930.0" styleClass="background" stylesheets="@settings.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <AnchorPane id="header" prefHeight="48.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label styleClass="scene-header" text="%runtime.scenes.settings.header" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0" />
        <HBox id="controls" alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="0.0">
            <fx:include source="../../components/buttons/minimize.fxml" />
            <fx:include source="../../components/buttons/maximize.fxml" />
            <fx:include source="../../components/buttons/exit.fxml" />
        </HBox>
    </AnchorPane>
    <fx:include source="../../components/panels/leftpanel.fxml" />

    <!-- Вкладки -->
    <HBox id="tabsBar" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="48.0">
        <children>
            <Button id="tabGeneralBtn" styleClass="settings-tab" text="%runtime.scenes.settings.tabs.general" />
            <Button id="tabJavaBtn" styleClass="settings-tab" text="%runtime.scenes.settings.header.java" />
            <Button id="tabInterfaceBtn" styleClass="settings-tab" text="%runtime.scenes.settings.tabs.interface" />
            <Button id="tabAccountBtn" styleClass="settings-tab" text="%runtime.scenes.settings.header.account" />
        </children>
    </HBox>

    <!-- Вибір клієнта -->
    <HBox id="profileBar" alignment="CENTER_LEFT" spacing="10.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="84.0">
        <children>
            <Label styleClass="settings-label" text="%runtime.scenes.settings.profileLabel" />
            <ComboBox id="profileCombo" minWidth="220.0" />
        </children>
    </HBox>

    <!-- ЗАГАЛЬНІ -->
    <ScrollPane id="settingslist" fitToWidth="true" hbarPolicy="NEVER" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="124.0">
        <VBox spacing="15.0">
            <children>
                <VBox styleClass="settings-card">
                    <children>
                        <AnchorPane maxHeight="-Infinity" maxWidth="1.7976931348623157E308">
                            <children>
                                <Label styleClass="settings-header" text="%runtime.scenes.settings.header.ram" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                <Label id="ramLabel" text="Label" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                            </children>
                        </AnchorPane>
                        <Slider id="ramSlider" prefHeight="17.0">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Slider>
                    </children>
                </VBox>
                <VBox styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-header" text="%runtime.scenes.settings.header.changeDirectory" />
                        <HBox id="folder" alignment="CENTER_LEFT" prefHeight="40.0">
                            <children>
                                <Hyperlink id="path" focusTraversable="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="C:\Users" HBox.hgrow="ALWAYS">
                                    <tooltip>
                                        <Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="Empty Tooltip" />
                                    </tooltip>
                                </Hyperlink>
                                <Button id="changeDir" alignment="BASELINE_CENTER" contentDisplay="RIGHT" maxHeight="1.7976931348623157E308" minWidth="215.0" styleClass="icon-button" text="%runtime.scenes.settings.dirText">
                                    <graphic>
                                        <SVGPath content="M12 6.3999H6.4H5V7.7999V16.1999V17.5999H19V16.1999L19 9.1999V7.7999H17.6H12V6.3999ZM10.6 9.1999H17.6V16.1999H6.4V7.7999H10.6V9.1999ZM14.7998 11.9999H13.4V10.5999H12V11.9999H13.3998V13.3999H14.7998V11.9999ZM14.7998 11.9999H16.1998V10.5999H14.7998L14.7998 11.9999ZM16.1998 13.3999H14.7998V14.7999H16.1998V13.3999ZM13.4 13.3999H12V14.7999H13.4V13.3999Z" styleClass="icon-button-color" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="%runtime.scenes.settings.changedirTooltip" />
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox id="settings-list" styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-header" text="%runtime.scenes.settings.header.options" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </ScrollPane>

    <!-- JAVA -->
    <ScrollPane id="tabJava" fitToWidth="true" hbarPolicy="NEVER" managed="false" visible="false" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="124.0">
        <VBox spacing="15.0">
            <children>
                <VBox styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-header" text="%runtime.scenes.settings.header.java" />
                        <HBox prefHeight="40.0" spacing="10.0">
                            <children>
                                <ComboBox id="javaCombo" maxHeight="1.7976931348623157E308" minWidth="296.0">
                                    <tooltip>
                                        <Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="Empty Tooltip" />
                                    </tooltip>
                                </ComboBox>
                                <Label maxHeight="1.7976931348623157E308" styleClass="settings-label" text="%runtime.scenes.settings.javaDesc" wrapText="true" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </ScrollPane>

    <!-- ІНТЕРФЕЙС -->
    <ScrollPane id="tabInterface" fitToWidth="true" hbarPolicy="NEVER" managed="false" visible="false" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="84.0">
        <VBox spacing="15.0">
            <children>
                <VBox styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-header" text="%runtime.scenes.settings.header.theme" />
                        <HBox prefHeight="40.0" spacing="10.0">
                            <children>
                                <ComboBox id="themeCombo" maxHeight="1.7976931348623157E308" minWidth="296.0">
                                    <tooltip>
                                        <Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="Empty Tooltip" />
                                    </tooltip>
                                </ComboBox>
                                <Label maxHeight="1.7976931348623157E308" styleClass="settings-label" text="%runtime.scenes.settings.themeDesc" wrapText="true" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
                <VBox styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-header" text="%runtime.scenes.settings.header.language" />
                        <HBox prefHeight="40.0" spacing="10.0">
                            <children>
                                <ComboBox id="languageCombo" maxHeight="1.7976931348623157E308" minWidth="296.0">
                                    <tooltip>
                                        <Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="Empty Tooltip" />
                                    </tooltip>
                                </ComboBox>
                                <Label maxHeight="1.7976931348623157E308" styleClass="settings-label" text="%runtime.scenes.settings.languageDesc" wrapText="true" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </ScrollPane>

    <!-- АКАУНТ -->
    <VBox id="tabAccount" managed="false" spacing="15.0" visible="false" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="84.0">
        <children>
            <VBox styleClass="settings-card">
                <children>
                    <Label styleClass="settings-header" text="%runtime.scenes.settings.header.account" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <children>
                            <StackPane maxHeight="52.0" maxWidth="52.0" minHeight="52.0" minWidth="52.0" prefHeight="52.0" prefWidth="52.0">
                                <children>
                                    <ImageView id="accountAvatar" fitHeight="52.0" fitWidth="52.0" smooth="false">
                                        <image>
                                            <Image url="@../../images/icons/default.png" />
                                        </image>
                                    </ImageView>
                                </children>
                            </StackPane>
                            <VBox>
                                <children>
                                    <Label id="accountNickname" styleClass="settings-label-header" text="PLAYER123" />
                                    <Label id="accountRole" styleClass="settings-label" />
                                </children>
                            </VBox>
                        </children>
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>

    <!-- Кнопки збереження -->
    <HBox id="settingsFooter" alignment="CENTER_RIGHT" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0">
        <children>
            <fx:include source="../../components/panels/savepanel.fxml" />
        </children>
    </HBox>
</AnchorPane>
