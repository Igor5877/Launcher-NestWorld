<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="serverPane" prefHeight="560.0" prefWidth="930.0" styleClass="background" stylesheets="@servermenu.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
      <fx:include source="../../components/panels/leftpanel.fxml" />
    <!-- Навбар -->
    <AnchorPane id="header" prefHeight="48.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label styleClass="scene-header" text="%runtime.scenes.servermenu.header" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0" />
        <!-- Кнопки управления -->
        <HBox id="controls" alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="0.0">
            <fx:include source="../../components/buttons/minimize.fxml" />
            <fx:include source="../../components/buttons/exit.fxml" />
        </HBox>
    </AnchorPane>

    <!-- Смуга статистики -->
    <HBox id="statsBar" alignment="CENTER_LEFT" spacing="16.0" prefHeight="34.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="48.0">
        <children>
            <Label id="statsOnline" text="?" />
            <Label id="statsServers" text="?" />
            <Region HBox.hgrow="ALWAYS" />
            <Label id="statsHint" text="%runtime.scenes.servermenu.selectServerHint" />
        </children>
    </HBox>

    <!-- Блок списка серверов -->
    <ScrollPane id="servers" fitToWidth="true" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="82.0">
        <VBox alignment="TOP_CENTER">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
        </VBox>
    </ScrollPane>
</AnchorPane>
