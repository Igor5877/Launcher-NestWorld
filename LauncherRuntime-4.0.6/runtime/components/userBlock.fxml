<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="9.0" stylesheets="@userBlock.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0">
            <children>
                <!-- Аватар игрока -->
                <ImageView id="avatar" fitHeight="30.0" fitWidth="30.0" smooth="false">
                    <Image url="@../images/icons/default.png" />
                </ImageView>
                <fx:include source="buttons/customization.fxml" />
            </children>
        </StackPane>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <!-- Никнейм игрока -->
                <Label id="nickname" maxWidth="110.0" text="PLAYER123" />
                <!-- Роль игрока -->
                <Label id="role" maxWidth="110.0">
                    <!-- <tooltip><Tooltip anchorLocation="WINDOW_BOTTOM_LEFT" text="%runtime.scenes.servermenu.moneyTooltip" /></tooltip> -->
                </Label>
            </children>
        </VBox>
    </children>
</HBox>